# Copie para .env e ajuste: cp .env.example .env

# Credenciais do painel (HTTP Basic). Deixar APP_PASSWORD vazio desativa a autenticação.
APP_USER=admin
APP_PASSWORD=troque-esta-senha

# Endereço em que o servidor escuta. Em produção atrás do Nginx/Caddy use 127.0.0.1:8000.
BIND_ADDRESS=0.0.0.0:8000

# Opcional: inicia a captura automaticamente nesta interface ao subir o container.
CAPTURE_INTERFACE=
# Opcional: filtro BPF da captura automática. Ex.: "not port 8000" para ignorar o próprio painel.
CAPTURE_FILTER=

# Gravação em lote no banco.
BATCH_SIZE=500
FLUSH_INTERVAL=1.0
LOG_LEVEL=INFO
